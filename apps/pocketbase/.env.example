# PocketBase configuration for Minha Leitura (self-host)
# Secrets/keys below are examples; override in real environments.

CF_ENCRYPTION_KEY=change-me-32-bytes-base64-or-hex
CF_MAIL_FROM=no-reply@minha-leitura.test
CF_MAIL_HOST=
CF_MAIL_PORT=587
CF_MAIL_USER=
CF_MAIL_PASS=
CF_CORS_ORIGINS=http://localhost:5173
CF_STEPUP_TTL=600
CF_TIMEZONE=America/Sao_Paulo
CF_APP_URL=http://localhost:5173
