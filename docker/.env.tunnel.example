# Copie para docker/.env.tunnel e preencha. Não versionar o .env.tunnel real.
#   cp docker/.env.tunnel.example docker/.env.tunnel

# Chave de 32+ bytes para AES-GCM do segredo 2FA. Gere com:
#   openssl rand -base64 32
# NÃO troque depois de ativar o 2FA.
CF_ENCRYPTION_KEY=

# Fuso de negócio.
CF_TIMEZONE=America/Sao_Paulo

# Validade do token de step-up (segundos).
CF_STEPUP_TTL=600

# --- Usuário inicial (dono do espaço) ---
# Ao pedir o Magic Link com este e-mail pela 1ª vez, a conta é criada
# automaticamente (ativa). Depois, entre e crie o espaço no onboarding.
CF_ADMIN_EMAIL=voce@exemplo.com
CF_ADMIN_NAME=Titular

# --- SMTP (envio do Magic Link) ---
# Sem isto, o link NÃO é enviado: ele aparece apenas no log do PocketBase.
#   docker compose -f docker/docker-compose.tunnel.yml logs --no-log-prefix pocketbase | grep MAGIC_LINK
#   (ou use ./scripts/magic-link.sh)
# Depois de preencher, aplique com ./scripts/mail-configure.sh
CF_MAIL_HOST=
CF_MAIL_PORT=587
CF_MAIL_USER=
CF_MAIL_PASS=
CF_MAIL_FROM=no-reply@minha-leitura.local
# true = TLS implícito (porta 465). Para STARTTLS (587/2525) use false.
CF_MAIL_TLS=false

# --- Notificações push (opcional) ---
CF_VAPID_PUBLIC_KEY=
CF_VAPID_PRIVATE_KEY=
CF_VAPID_SUBJECT=mailto:no-reply@minha-leitura.local
# Intervalo do notifier (ms) para entregar eventos. 60000 = 1 min.
CF_NOTIFIER_INTERVAL_MS=60000

# --- Superusuário do PocketBase (usado pelo notifier/deploy, opcional) ---
CF_POCKETBASE_ADMIN_EMAIL=admin@minha-leitura.local
CF_POCKETBASE_ADMIN_PASSWORD=

# --- URL pública (preenchida automaticamente pelos scripts de túnel) ---
CF_APP_URL=
CF_CORS_ORIGINS=
